{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "strictNullChecks": true,
    "isolatedModules": true,
    "noUnusedLocals": false
  },
  "include": [
    "src"
  ]
}