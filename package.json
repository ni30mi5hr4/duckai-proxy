{
  "name": "duckai-proxy",
  "version": "1.0.0",
  "description": "OpenAI-compatible API proxy for duck.ai — free AI models, no API key required",
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "sh scripts/setup-aider.sh",
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsdom": "^25.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "openai",
    "proxy",
    "duckduckgo",
    "duck.ai",
    "free",
    "api",
    "llm",
    "gpt"
  ]
}